# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
MNEMOS_HOST=0.0.0.0
MNEMOS_PORT=8000
MNEMOS_DEFAULT_TENANT_KEY=mnk_test_secret_key_12345

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://mnemos:mnemos_dev_secret@localhost:5432/mnemos
SYNC_DATABASE_URL=postgresql+psycopg://mnemos:mnemos_dev_secret@localhost:5432/mnemos

# Redis
REDIS_URL=redis://localhost:6379/0

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM & Reasoning (Optional API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
